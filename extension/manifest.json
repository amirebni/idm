{
  "manifest_version": 3,
  "name": "MyDM Downloader",
  "version": "2.4.0",
  "description": "Offers to download the videos and music you play in the browser (files, HLS/DASH streams, YouTube and more) with MyDM.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["webRequest", "storage", "cookies", "downloads", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "MyDM", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
